<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_goal_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Close button -->
    <ImageView
        android:id="@+id/btnDialogExitClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/goal_icon_description"
        android:padding="4dp"
        android:src="@drawable/ic_goal_close" />

    <!-- Warning Icon -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/goal_icon_description"
        android:src="@drawable/ic_goal_warning" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:text="@string/goal_exit_title"
        android:textColor="@color/goal_text_primary"
        android:textSize="18sp" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/goal_exit_message"
        android:textColor="@color/goal_text_secondary"
        android:textSize="13sp" />

    <!-- Continue Test Button (Outlined/Soft) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogExitContinue"
        style="@style/Widget.AuraEnglish.AuthOutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/goal_button_height"
        android:layout_marginTop="20dp"
        android:text="@string/goal_exit_continue" />

    <!-- Exit Button (Primary Blue) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogExitConfirm"
        style="@style/Widget.AuraEnglish.AuthPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/goal_button_height"
        android:layout_marginTop="10dp"
        android:text="@string/goal_exit_confirm" />

</LinearLayout>
