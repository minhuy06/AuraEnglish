<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/listen_bg"
    tools:context=".listening.ui.ListeningQuestionActivity">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/listen_prev"
            android:padding="12dp"
            android:src="@drawable/ic_practice_back"
            app:tint="@color/listen_text" />

        <TextView
            android:id="@+id/tvExamTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/dash_display"
            android:textColor="@color/listen_text"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="NGHE DICTATION 01" />

        <TextView
            android:id="@+id/tvQuestionProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/dash_body"
            android:textColor="@color/listen_text_secondary"
            android:textSize="13sp"
            tools:text="Câu 1 / 10" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/navBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_listen_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_listen_play_btn"
                        android:contentDescription="@string/listen_play"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_listen_play" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <SeekBar
                            android:id="@+id/seekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="1000"
                            android:progress="0"
                            android:progressTint="@color/listen_seek"
                            android:thumbTint="@color/listen_primary" />

                        <TextView
                            android:id="@+id/tvTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dash_body"
                            android:textColor="@color/listen_text_secondary"
                            android:textSize="12sp"
                            tools:text="0:00 / 0:05" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/dash_body"
                android:text="@string/listen_blank_label"
                android:textColor="@color/listen_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBlankPattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_listen_input"
                android:fontFamily="@font/dash_body"
                android:letterSpacing="0.04"
                android:lineSpacingMultiplier="1.45"
                android:padding="14dp"
                android:textColor="@color/listen_blank"
                android:textSize="16sp"
                tools:text="**** ***** ******* *** **** ******** ** ***." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/dash_body"
                android:text="@string/listen_answer_hint"
                android:textColor="@color/listen_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_listen_input"
                android:fontFamily="@font/dash_body"
                android:gravity="top|start"
                android:hint="@string/listen_answer_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/listen_text"
                android:textColorHint="@color/listen_text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvResultLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/dash_body"
                android:text="@string/listen_result_label"
                android:textColor="@color/listen_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWordResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_listen_input"
                android:fontFamily="@font/dash_body"
                android:lineSpacingMultiplier="1.5"
                android:padding="14dp"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="This audio …" />

            <TextView
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_listen_primary_btn"
                android:fontFamily="@font/dash_body"
                android:gravity="center"
                android:text="@string/listen_submit"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/listen_surface"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_listen_soft_btn"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/listen_prev"
            android:textColor="@color/listen_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_listen_soft_btn"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/listen_next"
            android:textColor="@color/listen_primary"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
