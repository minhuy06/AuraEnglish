<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAuthLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/loginScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <include
                android:id="@+id/authHeader"
                layout="@layout/include_auth_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Space
                android:id="@+id/loginCardAnchor"
                android:layout_width="0dp"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="@id/authHeader"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/auth_screen_padding"
                android:background="@drawable/bg_auth_card"
                android:elevation="7dp"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/loginCardAnchor">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLoginEmail"
                    style="@style/Widget.AuraEnglish.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_email_label"
                    app:errorEnabled="true"
                    app:placeholderText="@string/auth_email_hint"
                    app:placeholderTextColor="@color/auth_text_hint"
                    app:startIconDrawable="@drawable/ic_auth_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtLoginEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilLoginPassword"
                    style="@style/Widget.AuraEnglish.AuthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auth_field_gap"
                    android:hint="@string/auth_password_label"
                    app:endIconMode="password_toggle"
                    app:errorEnabled="true"
                    app:placeholderText="@string/auth_password_hint"
                    app:placeholderTextColor="@color/auth_text_hint"
                    app:startIconDrawable="@drawable/ic_auth_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtLoginPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:minHeight="56dp"
                        android:textColor="@color/auth_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:text="@string/auth_forgot_link"
                    android:textColor="@color/auth_primary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/layoutAdminHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_auth_pill"
                    android:backgroundTint="@color/auth_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvAdminHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:text="@string/auth_admin_hint_text"
                        android:textColor="@color/auth_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvAdminQuickFill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="2dp"
                        android:text="@string/auth_admin_fill_action"
                        android:textColor="@color/auth_primary"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/loginActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/auth_screen_padding"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginCard"
                app:layout_constraintVertical_bias="1.0">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.AuraEnglish.AuthPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:text="@string/auth_login_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.AuraEnglish.AuthOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auth_button_height"
                    android:layout_marginTop="12dp"
                    android:text="@string/auth_google_button" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:text="@string/auth_no_account"
                        android:textColor="@color/auth_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOpenRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:gravity="center"
                        android:paddingHorizontal="5dp"
                        android:text="@string/auth_register_link"
                        android:textColor="@color/auth_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
