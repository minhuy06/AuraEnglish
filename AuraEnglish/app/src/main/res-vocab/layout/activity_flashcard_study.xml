<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFlashcardStudy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vocab_bg"
    android:padding="@dimen/vocab_screen_padding">

    <!-- Top Bar: Back + Topic Title + Progress Bar & Counter -->
    <ImageButton
        android:id="@+id/btnBackFlashcard"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/vocab_back_desc"
        android:src="@drawable/ic_practice_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vocab_text_primary" />

    <TextView
        android:id="@+id/tvFlashcardTopicTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/vocab_text_primary"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/btnBackFlashcard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBackFlashcard" />

    <ProgressBar
        android:id="@+id/pbFlashcardProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/progress_vocab_horizontal"
        app:layout_constraintEnd_toStartOf="@id/tvFlashcardCounter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBackFlashcard" />

    <TextView
        android:id="@+id/tvFlashcardCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:textColor="@color/vocab_primary_royal"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/pbFlashcardProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/pbFlashcardProgress" />

    <!-- Thẻ Flashcard chính (Chạm để lật mặt trước / mặt sau) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardFlashcardMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="20dp"
        android:background="@drawable/bg_vocab_flashcard"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:padding="22dp"
        app:layout_constraintBottom_toTopOf="@id/layoutSrsButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pbFlashcardProgress">

        <!-- Hàng Từ tiếng Anh + Nút Loa -->
        <LinearLayout
            android:id="@+id/rowFlashcardWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvFlashcardWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:textColor="@color/vocab_text_primary"
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/btnFlashcardSpeak"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_vocab_speaker_circle"
                android:contentDescription="@string/vocab_speak_desc"
                android:padding="8dp"
                android:src="@drawable/ic_vocab_speaker" />
        </LinearLayout>

        <!-- Phiên âm IPA & Từ loại -->
        <LinearLayout
            android:id="@+id/rowFlashcardPhonetic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowFlashcardWord">

            <TextView
                android:id="@+id/tvFlashcardPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:textColor="@color/vocab_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFlashcardPosTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:textColor="@color/vocab_primary_royal"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Khung minh họa Mặt trước (Illustration Box) -->
        <LinearLayout
            android:id="@+id/layoutFrontIllustration"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="18dp"
            android:background="@drawable/bg_vocab_illustration_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintBottom_toTopOf="@id/tvFlipHint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowFlashcardPhonetic">

            <TextView
                android:id="@+id/tvIllustrationEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💼"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/tvIllustrationCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:gravity="center"
                android:textColor="@color/vocab_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Khung Mặt sau: Nghĩa tiếng Việt & Câu ví dụ -->
        <LinearLayout
            android:id="@+id/layoutBackMeaning"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="18dp"
            android:background="@drawable/bg_vocab_summary_banner"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/tvFlipHint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowFlashcardPhonetic">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/vocab_flashcard_meaning_label"
                android:textColor="@color/vocab_primary_royal"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvFlashcardMeaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:textColor="@color/vocab_text_primary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/vocab_flashcard_example_label"
                android:textColor="@color/vocab_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFlashcardExample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:gravity="center"
                android:textColor="@color/vocab_text_primary"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Dòng nhắc Chạm vào thẻ để xem nghĩa ↻ -->
        <TextView
            android:id="@+id/tvFlipHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:text="@string/vocab_flashcard_tap_to_flip"
            android:textColor="@color/vocab_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2 Nút SRS dưới đáy: Chưa thuộc (Trái) & Đã thuộc (Phải) -->
    <LinearLayout
        android:id="@+id/layoutSrsButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnSrsUnlearned"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vocab_srs_unlearned"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/vocab_srs_unlearned_title"
                android:textColor="@color/vocab_unlearned_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/vocab_srs_unlearned_sub"
                android:textColor="@color/vocab_unlearned_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSrsLearned"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vocab_srs_learned"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/vocab_srs_learned_title"
                android:textColor="@color/vocab_learned_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/vocab_srs_learned_sub"
                android:textColor="@color/vocab_learned_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
