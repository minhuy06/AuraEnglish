<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/practice_card_gap"
    android:background="@drawable/bg_practice_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="3dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_practice_q_current"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="11" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_practice_tag"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/practice_tag_text"
                android:textSize="11sp"
                tools:text="Ngữ pháp - Từ loại" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_practice_bookmark" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/practice_text_primary"
            android:textSize="13sp"
            tools:text="The new policy has been ______ by all department managers." />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_practice_status_doing"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/practice_chip_progress_text"
            android:textSize="11sp"
            tools:text="Đã chọn: C" />
    </LinearLayout>
</LinearLayout>
