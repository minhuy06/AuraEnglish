<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_admin_card"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvStudentAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_admin_student_avatar"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:textColor="@color/admin_primary"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="AK" />

    <TextView
        android:id="@+id/tvStudentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:maxLines="1"
        android:textColor="@color/admin_text_primary"
        android:textSize="13.5sp"
        app:layout_constraintEnd_toStartOf="@id/tvStudentStatus"
        app:layout_constraintStart_toEndOf="@id/tvStudentAvatar"
        app:layout_constraintTop_toTopOf="@id/tvStudentAvatar"
        tools:text="Nguyễn An Khang" />

    <TextView
        android:id="@+id/tvStudentEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:maxLines="1"
        android:textColor="@color/admin_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/tvStudentStatus"
        app:layout_constraintStart_toEndOf="@id/tvStudentAvatar"
        app:layout_constraintTop_toBottomOf="@id/tvStudentName"
        tools:text="ankhang@gmail.com" />

    <TextView
        android:id="@+id/tvStudentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_student_status"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:textColor="@color/admin_success"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Đang học" />

    <TextView
        android:id="@+id/tvStudentCourse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:maxLines="1"
        android:textColor="@color/admin_text_primary"
        android:textSize="11.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStudentAvatar"
        tools:text="Khóa học: Ngữ pháp trọng tâm" />

    <TextView
        android:id="@+id/tvStudentProgressLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:text="@string/admin_student_progress_label"
        android:textColor="@color/admin_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/tvStudentProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStudentCourse" />

    <TextView
        android:id="@+id/tvStudentProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:textColor="@color/admin_primary"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvStudentProgressLabel"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="72%" />

    <ProgressBar
        android:id="@+id/pbStudentProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="72"
        android:progressBackgroundTint="@color/admin_primary_soft"
        android:progressTint="@color/admin_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStudentProgressLabel" />

    <TextView
        android:id="@+id/tvStudentLearningMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:maxLines="1"
        android:textColor="@color/admin_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/tvStudentLastActive"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pbStudentProgress"
        tools:text="18/24 bài • Chuỗi 12 ngày" />

    <TextView
        android:id="@+id/tvStudentLastActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:gravity="end"
        android:textColor="@color/admin_text_placeholder"
        android:textSize="11sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvStudentLearningMeta"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Hoạt động: 5 phút trước" />

    <LinearLayout
        android:id="@+id/studentActions"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="11dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStudentLearningMeta">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudentProfile"
            style="@style/Widget.AuraEnglish.AdminSoftButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="@string/admin_student_action_profile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStudentStatusAction"
            style="@style/Widget.AuraEnglish.AdminDangerButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:text="@string/admin_student_action_suspend" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
