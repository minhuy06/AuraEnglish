<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRoomLobby"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/room_bg"
    android:padding="@dimen/room_screen_padding">

    <!-- Top Bar -->
    <ImageButton
        android:id="@+id/btnBackLobby"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/room_back_desc"
        android:src="@drawable/ic_practice_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/room_text_primary" />

    <TextView
        android:id="@+id/tvLobbyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:text="@string/room_lobby_title"
        android:textColor="@color/room_text_primary"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/btnBackLobby"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBackLobby" />

    <!-- Card Thông tin Phòng & Mã phòng -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardRoomInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_room_card"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBackLobby">

        <TextView
            android:id="@+id/tvLobbyRoomName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:textColor="@color/room_text_primary"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/tvLobbyTopicBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLobbyTopicBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_room_btn_outlined"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/room_primary_royal"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLobbyConfigMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:textColor="@color/room_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLobbyRoomName" />

        <!-- Hộp Mã Phòng + Nút Sao chép -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/boxRoomCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_room_code_box"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLobbyConfigMeta">

            <TextView
                android:id="@+id/tvCodeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/room_lobby_code_label"
                android:textColor="@color/room_text_secondary"
                android:textSize="10.5sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvLobbyRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:letterSpacing="0.12"
                android:textColor="@color/room_primary"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCodeLabel" />

            <LinearLayout
                android:id="@+id/btnCopyRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_room_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/room_lobby_btn_copy"
                    android:src="@drawable/ic_room_copy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:text="@string/room_lobby_btn_copy"
                    android:textColor="@color/room_primary_royal"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Header Danh sách thành viên + Nút Mời -->
    <TextView
        android:id="@+id/tvMembersHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:textColor="@color/room_text_primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btnInviteMember"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardRoomInfo" />

    <LinearLayout
        android:id="@+id/btnInviteMember"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_room_btn_outlined"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="@id/tvMembersHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvMembersHeader">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/room_lobby_btn_invite"
            android:src="@drawable/ic_room_invite" />

        <TextView
            android:id="@+id/tvInviteBtnLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/room_lobby_btn_invite"
            android:textColor="@color/room_primary_royal"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Danh sách 4 slot thành viên -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoomMembers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/tvRoomFullHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnInviteMember" />

    <TextView
        android:id="@+id/tvRoomFullHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:gravity="center"
        android:text="@string/room_lobby_need_more_members"
        android:textColor="@color/room_text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/btnStartRoomExam"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Nút Bắt đầu thi & Rời phòng -->
    <TextView
        android:id="@+id/btnStartRoomExam"
        android:layout_width="0dp"
        android:layout_height="@dimen/room_btn_height"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_room_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/room_lobby_btn_start"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/btnLeaveRoom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnLeaveRoom"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_room_btn_danger_soft"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/room_lobby_btn_leave"
        android:textColor="@color/room_danger_text"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
