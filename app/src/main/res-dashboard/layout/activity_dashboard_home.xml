<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    tools:context=".dashboard.ui.DashboardHomeActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavInclude"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_dash_avatar"
                    android:fontFamily="@font/dash_body"
                    android:gravity="center"
                    android:text="DH"
                    android:textColor="@color/dash_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/dash_display"
                    android:text="@string/dash_greeting_name"
                    android:textColor="@color/dash_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCart"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dash_cart"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_rank_cart" />

                <ImageButton
                    android:id="@+id/btnBell"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dash_notifications"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_rank_bell" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dash_card"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <ProgressBar
                        android:id="@+id/goalProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="80"
                        android:progressDrawable="@drawable/bg_dash_ring_progress" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/dash_display"
                        android:gravity="center"
                        android:text="@string/dash_daily_percent"
                        android:textColor="@color/dash_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dash_display"
                        android:text="@string/dash_daily_goal"
                        android:textColor="@color/dash_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_daily_progress"
                        android:textColor="@color/dash_text_muted"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dash_streak" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/dash_body"
                            android:text="@string/dash_streak"
                            android:textColor="@color/dash_primary_mid"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/weekStrip"
                layout="@layout/include_dash_week_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

            <include
                android:id="@+id/heroInclude"
                layout="@layout/include_dash_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/dash_display"
                android:text="@string/dash_continue_title"
                android:textColor="@color/dash_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/continueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dash_card_soft"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_dash_skill_vocab">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dash_continue" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_continue_course"
                        android:textColor="@color/dash_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_continue_meta"
                        android:textColor="@color/dash_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/dash_display"
                android:text="@string/dash_skills_title"
                android:textColor="@color/dash_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/skillVocab"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dash_skill_vocab"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dash_vocab" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_vocab"
                        android:textColor="@color/dash_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_vocab_meta"
                        android:textColor="@color/dash_text_muted"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_dash_skill_progress_track">

                        <View
                            android:id="@+id/skillVocabProgress"
                            android:layout_width="42dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dash_skill_progress_fill" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/skillGrammar"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dash_skill_grammar"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dash_grammar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_grammar"
                        android:textColor="@color/dash_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_grammar_meta"
                        android:textColor="@color/dash_text_muted"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_dash_skill_progress_track">

                        <View
                            android:id="@+id/skillGrammarProgress"
                            android:layout_width="78dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dash_skill_progress_fill" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/skillExam"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dash_skill_exam"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dash_exam" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_exam"
                        android:textColor="@color/dash_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_exam_meta"
                        android:textColor="@color/dash_text_muted"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_dash_skill_progress_track">

                        <View
                            android:id="@+id/skillExamProgress"
                            android:layout_width="35dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dash_skill_progress_fill" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/skillListen"
                    android:layout_width="0dp"
                    android:layout_height="124dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dash_skill_listen"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dash_listen" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_listen"
                        android:textColor="@color/dash_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/dash_body"
                        android:text="@string/dash_skill_listen_meta"
                        android:textColor="@color/dash_text_muted"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_dash_skill_progress_track">

                        <View
                            android:id="@+id/skillListenProgress"
                            android:layout_width="18dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_dash_skill_progress_fill" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNavInclude"
        layout="@layout/include_practice_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="@dimen/practice_bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
