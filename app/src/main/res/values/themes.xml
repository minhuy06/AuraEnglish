<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AuraEnglish" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/admin_primary</item>
        <item name="android:statusBarColor">@color/admin_surface</item>
        <item name="android:navigationBarColor">@color/admin_surface</item>
        <item name="android:windowBackground">@color/admin_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.AuraEnglish.AdminDialog</item>
    </style>

    <style name="Theme.AuraEnglish" parent="Base.Theme.AuraEnglish" />

    <style name="ThemeOverlay.AuraEnglish.AdminDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AuraEnglish.AdminDialog</item>
    </style>

    <style name="ShapeAppearance.AuraEnglish.AdminDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/admin_popup_radius</item>
    </style>

    <style name="TextAppearance.AuraEnglish.AdminTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/admin_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.AuraEnglish.AdminBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/admin_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.AuraEnglish.AdminPrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/admin_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/admin_btn_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="Widget.AuraEnglish.AdminSoftButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/admin_primary_soft</item>
        <item name="strokeColor">@color/admin_primary_border</item>
        <item name="android:textColor">@color/admin_primary</item>
        <item name="cornerRadius">@dimen/admin_btn_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.AuraEnglish.AdminNeutralButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/admin_bg</item>
        <item name="strokeColor">@color/admin_border_muted</item>
        <item name="android:textColor">@color/admin_text_action</item>
        <item name="cornerRadius">@dimen/admin_btn_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.AuraEnglish.AdminDangerButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/admin_danger_soft</item>
        <item name="strokeColor">@color/admin_danger_border</item>
        <item name="android:textColor">@color/admin_danger</item>
        <item name="cornerRadius">@dimen/admin_btn_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
