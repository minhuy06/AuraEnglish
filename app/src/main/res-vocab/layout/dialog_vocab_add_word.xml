<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_vocab_card"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/practice_add_word"
            android:textColor="@color/vocab_text_primary"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnCloseAddWord"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_practice_close" />
    </LinearLayout>

    <!-- Từ tiếng Anh * -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/practice_word_english_label"
        android:textColor="@color/vocab_text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etVocabEnglish"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_practice_option"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:hint="@string/practice_word_english_hint"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/vocab_text_primary"
        android:textColorHint="@color/vocab_text_muted"
        android:textSize="14sp" />

    <!-- Nghĩa tiếng Việt * -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/vocab_word_meaning_label"
        android:textColor="@color/vocab_text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etVocabMeaning"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_practice_option"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:hint="@string/vocab_word_meaning_hint"
        android:inputType="textCapSentences"
        android:paddingHorizontal="12dp"
        android:textColor="@color/vocab_text_primary"
        android:textColorHint="@color/vocab_text_muted"
        android:textSize="14sp" />

    <!-- Phiên âm (nếu có) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/practice_word_phonetic_label"
        android:textColor="@color/vocab_text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etVocabPhonetic"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_practice_option"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:hint="@string/practice_word_phonetic_hint"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/vocab_text_primary"
        android:textColorHint="@color/vocab_text_muted"
        android:textSize="14sp" />

    <!-- Chọn chủ đề * + Tự tạo chủ đề mới + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/practice_word_topic_label"
            android:textColor="@color/vocab_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnInlineCreateTopic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/practice_word_new_topic"
            android:textColor="@color/vocab_primary_royal"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectedTopicDropdown"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_practice_option"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="@string/practice_word_topic_default"
        android:textColor="@color/vocab_text_primary"
        android:textSize="14sp" />

    <!-- Từ loại (4 pill chips) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/practice_word_type_label"
        android:textColor="@color/vocab_text_primary"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipPosNoun"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_vocab_tab_active"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/practice_word_type_noun"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipPosVerb"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_vocab_tab_inactive"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/practice_word_type_verb"
                android:textColor="@color/vocab_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipPosAdj"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_vocab_tab_inactive"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/practice_word_type_adj"
                android:textColor="@color/vocab_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipPosAdv"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_vocab_tab_inactive"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/practice_word_type_adv"
                android:textColor="@color/vocab_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvAddWordError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:textColor="@color/vocab_unlearned_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnConfirmAddWord"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_vocab_btn_primary"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:text="@string/practice_word_save_to_library"
        android:textColor="@color/white"
        android:textSize="14sp" />
</LinearLayout>
