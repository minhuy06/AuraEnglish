<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGoalReminder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/profile_screen_padding">

        <!-- Header -->
        <ImageButton
            android:id="@+id/btnBackGoal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_btn_back"
            android:src="@drawable/ic_practice_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/profile_text_primary" />

        <TextView
            android:id="@+id/tvGoalHeaderTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/profile_goal_header_tag"
            android:textColor="@color/profile_primary_royal"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/btnBackGoal"
            app:layout_constraintStart_toEndOf="@id/btnBackGoal"
            app:layout_constraintTop_toTopOf="@id/btnBackGoal" />

        <TextView
            android:id="@+id/tvGoalPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/profile_goal_page_title"
            android:textColor="@color/profile_text_primary"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBackGoal" />

        <TextView
            android:id="@+id/tvGoalPageSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:text="@string/profile_goal_page_subtitle"
            android:textColor="@color/profile_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGoalPageTitle" />

        <!-- MỤC TIÊU HÀNG NGÀY -->
        <TextView
            android:id="@+id/tvSecDailyGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/profile_sec_daily_goal"
            android:textColor="@color/profile_text_secondary"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGoalPageSubtitle" />

        <!-- Card 1: Cơ bản 3 bài -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardGoal3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSecDailyGoal">

            <TextView
                android:id="@+id/badgeGoal3"
                android:layout_width="@dimen/profile_badge_size"
                android:layout_height="@dimen/profile_badge_size"
                android:background="@drawable/bg_profile_badge_green"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/profile_success_text"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGoal3Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/profile_goal_3_title"
                android:textColor="@color/profile_text_primary"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/tvGoal3Check"
                app:layout_constraintStart_toEndOf="@id/badgeGoal3"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGoal3Sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/profile_goal_3_sub"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/tvGoal3Check"
                app:layout_constraintStart_toEndOf="@id/badgeGoal3"
                app:layout_constraintTop_toBottomOf="@id/tvGoal3Title" />

            <TextView
                android:id="@+id/tvGoal3Check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_profile_avatar_circle"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card 2: Tiêu chuẩn 5 bài (mặc định chọn) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardGoal5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_profile_card_selected"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardGoal3">

            <TextView
                android:id="@+id/badgeGoal5"
                android:layout_width="@dimen/profile_badge_size"
                android:layout_height="@dimen/profile_badge_size"
                android:background="@drawable/bg_profile_badge_blue"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/profile_primary_royal"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGoal5Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/profile_goal_5_title"
                android:textColor="@color/profile_text_primary"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/tvGoal5Check"
                app:layout_constraintStart_toEndOf="@id/badgeGoal5"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGoal5Sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/profile_goal_5_sub_selected"
                android:textColor="@color/profile_primary_royal"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/tvGoal5Check"
                app:layout_constraintStart_toEndOf="@id/badgeGoal5"
                app:layout_constraintTop_toBottomOf="@id/tvGoal5Title" />

            <TextView
                android:id="@+id/tvGoal5Check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_profile_avatar_circle"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card 3: Chăm chỉ 10 bài -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardGoal10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_profile_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardGoal5">

            <TextView
                android:id="@+id/badgeGoal10"
                android:layout_width="@dimen/profile_badge_size"
                android:layout_height="@dimen/profile_badge_size"
                android:background="@drawable/bg_profile_badge_purple"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:text="10"
                android:textColor="@color/profile_purple_text"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGoal10Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/profile_goal_10_title"
                android:textColor="@color/profile_text_primary"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/tvGoal10Check"
                app:layout_constraintStart_toEndOf="@id/badgeGoal10"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvGoal10Sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/profile_goal_10_sub"
                android:textColor="@color/profile_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/tvGoal10Check"
                app:layout_constraintStart_toEndOf="@id/badgeGoal10"
                app:layout_constraintTop_toBottomOf="@id/tvGoal10Title" />

            <TextView
                android:id="@+id/tvGoal10Check"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_profile_avatar_circle"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- NHẮC NHỞ HỌC TẬP -->
        <TextView
            android:id="@+id/tvSecReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/profile_sec_reminder"
            android:textColor="@color/profile_text_secondary"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardGoal10" />

        <LinearLayout
            android:id="@+id/cardReminderOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSecReminder">

            <!-- Hàng Giờ nhắc học hằng ngày -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rowReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="14dp">

                <TextView
                    android:id="@+id/badgeTime20"
                    android:layout_width="@dimen/profile_badge_size"
                    android:layout_height="@dimen/profile_badge_size"
                    android:background="@drawable/bg_profile_badge_blue"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="20"
                    android:textColor="@color/profile_primary_royal"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvReminderTimeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/profile_reminder_time_title"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/tvReminderTimeChip"
                    app:layout_constraintStart_toEndOf="@id/badgeTime20"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:text="@string/profile_reminder_time_sub"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/tvReminderTimeChip"
                    app:layout_constraintStart_toEndOf="@id/badgeTime20"
                    app:layout_constraintTop_toBottomOf="@id/tvReminderTimeTitle" />

                <TextView
                    android:id="@+id/tvReminderTimeChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_btn_outlined"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/profile_reminder_time_default"
                    android:textColor="@color/profile_primary_royal"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="14dp"
                android:background="@color/profile_border" />

            <!-- Hàng Nhắc bảo vệ chuỗi Streak -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <TextView
                    android:id="@+id/badgeStreak7d"
                    android:layout_width="@dimen/profile_badge_size"
                    android:layout_height="@dimen/profile_badge_size"
                    android:background="@drawable/bg_profile_badge_blue"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="7d"
                    android:textColor="@color/profile_primary_royal"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvStreakReminderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="@string/profile_reminder_streak_title"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/swStreakProtection"
                    app:layout_constraintStart_toEndOf="@id/badgeStreak7d"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:text="@string/profile_reminder_streak_sub"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/swStreakProtection"
                    app:layout_constraintStart_toEndOf="@id/badgeStreak7d"
                    app:layout_constraintTop_toBottomOf="@id/tvStreakReminderTitle" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swStreakProtection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- Nút Lưu thiết lập & Quay lại -->
        <TextView
            android:id="@+id/btnSaveGoalSettings"
            android:layout_width="0dp"
            android:layout_height="@dimen/profile_btn_height"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_profile_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/profile_btn_save_goal"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardReminderOptions" />

        <TextView
            android:id="@+id/tvBackFromGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/profile_btn_back"
            android:textColor="@color/profile_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSaveGoalSettings" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
