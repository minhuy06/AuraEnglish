<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWordItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_vocab_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvWordEnglish"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:textColor="@color/vocab_text_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/btnWordSpeak"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnWordSpeak"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_vocab_speaker_circle"
        android:contentDescription="@string/vocab_speak_desc"
        android:padding="7dp"
        android:src="@drawable/ic_vocab_speaker"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWordPhonetic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:textColor="@color/vocab_text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWordEnglish" />

    <TextView
        android:id="@+id/tvWordPosTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/be_vietnam_pro_semibold"
        android:textColor="@color/vocab_primary_royal"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvWordPhonetic"
        app:layout_constraintStart_toEndOf="@id/tvWordPhonetic" />

    <TextView
        android:id="@+id/tvWordMeaning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:textColor="@color/vocab_text_primary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvWordStatusBadge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWordPhonetic" />

    <TextView
        android:id="@+id/tvWordStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_vocab_badge_learned"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/vocab_status_learned"
        android:textColor="@color/vocab_learned_text"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
