<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRoomRanking"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/room_bg"
    android:padding="@dimen/room_screen_padding">

    <!-- Header -->
    <TextView
        android:id="@+id/tvRoomRankTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:text="@string/room_ranking_title"
        android:textColor="@color/room_text_primary"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvRoomRankSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:gravity="center"
        android:textColor="@color/room_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRoomRankTitle" />

    <!-- Banner tóm tắt thành tích của bạn -->
    <TextView
        android:id="@+id/tvYourRankSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_room_btn_outlined"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@color/room_primary"
        android:textSize="12.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRoomRankSubtitle" />

    <!-- Podium Top 3 -->
    <LinearLayout
        android:id="@+id/layoutPodium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvYourRankSummary">

        <!-- Hạng 2 -->
        <LinearLayout
            android:id="@+id/podiumSecond"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_room_podium_2"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥈"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvPodium2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:maxLines="1"
                android:textColor="@color/room_text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvPodium2Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:textColor="@color/room_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Hạng 1 -->
        <LinearLayout
            android:id="@+id/podiumFirst"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_room_podium_1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥇"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvPodium1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:maxLines="1"
                android:textColor="@color/room_gold_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPodium1Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:textColor="@color/room_text_primary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Hạng 3 -->
        <LinearLayout
            android:id="@+id/podiumThird"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_room_podium_3"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥉"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvPodium3Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:maxLines="1"
                android:textColor="@color/room_text_primary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvPodium3Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:textColor="@color/room_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Danh sách đầy đủ kết quả các thành viên -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoomRankings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="14dp"
        app:layout_constraintBottom_toTopOf="@id/btnRoomRematch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPodium" />

    <!-- 2 Nút hành động dưới đáy -->
    <TextView
        android:id="@+id/btnRoomRematch"
        android:layout_width="0dp"
        android:layout_height="@dimen/room_btn_height"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_room_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/room_ranking_btn_rematch"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/btnRoomBackHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/btnRoomBackHome"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_room_btn_outlined"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/room_ranking_btn_home"
        android:textColor="@color/room_primary_royal"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
