<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAuthRegister"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background">

    <include
        android:id="@+id/authHeader"
        layout="@layout/include_auth_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_header_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/registerScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/auth_screen_padding"
        android:paddingTop="178dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/registerActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_card"
            android:elevation="7dp"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegisterName"
                style="@style/Widget.AuraEnglish.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auth_name_label"
                app:errorEnabled="true"
                app:startIconDrawable="@drawable/ic_auth_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRegisterName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:autofillHints="name"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:hint="@string/auth_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegisterEmail"
                style="@style/Widget.AuraEnglish.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_gap"
                android:hint="@string/auth_email_label"
                app:errorEnabled="true"
                app:startIconDrawable="@drawable/ic_auth_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRegisterEmail"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:autofillHints="emailAddress"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:hint="@string/auth_email_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegisterPassword"
                style="@style/Widget.AuraEnglish.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_gap"
                android:hint="@string/auth_password_label"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:startIconDrawable="@drawable/ic_auth_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRegisterPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:autofillHints="newPassword"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:hint="@string/auth_password_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegisterConfirmation"
                style="@style/Widget.AuraEnglish.AuthInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_gap"
                android:hint="@string/auth_confirm_password_label"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:startIconDrawable="@drawable/ic_auth_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRegisterConfirmation"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:autofillHints="newPassword"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:hint="@string/auth_confirm_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/auth_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbAcceptTerms"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/auth_accept_terms"
                android:textColor="@color/auth_text_secondary"
                android:textSize="11sp"
                app:buttonTint="@color/auth_primary" />

            <TextView
                android:id="@+id/tvTermsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/auth_error_terms_required"
                android:textColor="@color/auth_error"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/registerActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/auth_screen_padding"
        android:layout_marginBottom="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.AuraEnglish.AuthPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_button_height"
            android:text="@string/auth_action_register" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/auth_have_account"
                android:textColor="@color/auth_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRegisterLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:paddingHorizontal="5dp"
                android:text="@string/auth_login_link"
                android:textColor="@color/auth_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
