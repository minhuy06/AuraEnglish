<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/admin_card_gap"
    app:cardBackgroundColor="@color/admin_surface"
    app:cardCornerRadius="@dimen/admin_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/admin_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvIndex"
                android:layout_width="@dimen/admin_index_size"
                android:layout_height="@dimen/admin_index_size"
                android:background="@drawable/bg_admin_index_free"
                android:gravity="center"
                android:textColor="@color/admin_success"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="03" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/admin_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Đề thi thử TOEIC 01" />

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_admin_free_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/admin_badge_free"
                android:textColor="@color/admin_success"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/admin_text_secondary"
            android:textSize="12sp"
            tools:text="200 câu • 120 phút (Part 1 - Part 7)" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/admin_text_muted"
            android:textSize="11.5sp"
            tools:text="Lượt làm bài: 845 lượt • Điểm TB: 685/990" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuestions"
                style="@style/Widget.AuraEnglish.AdminSoftButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.2"
                android:text="@string/admin_action_questions_explain" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.AuraEnglish.AdminNeutralButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:text="@string/admin_action_edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.AuraEnglish.AdminDangerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="0.9"
                android:text="@string/admin_action_delete" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
