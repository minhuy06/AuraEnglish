<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGoalSelection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Bar with Step -->
    <TextView
        android:id="@+id/tvGoalSetupLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/goal_screen_padding"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/goal_setup_label"
        android:textColor="@color/goal_text_secondary"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGoalStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/goal_screen_padding"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:text="Bước 1/3"
        android:textColor="@color/goal_primary"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvGoalSetupLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Title -->
    <TextView
        android:id="@+id/tvGoalTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/goal_screen_padding"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/goal_select_title"
        android:textColor="@color/goal_text_primary"
        android:textSize="22sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalSetupLabel" />

    <TextView
        android:id="@+id/tvGoalSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/goal_screen_padding"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:text="@string/goal_select_subtitle"
        android:textColor="@color/goal_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalTitle" />

    <!-- Scrollable container for Goal options -->
    <ScrollView
        android:id="@+id/scrollGoalOptions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/goal_screen_padding"
        app:layout_constraintBottom_toTopOf="@id/btnGoalContinue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoalSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Option 1: Daily Communication -->
            <LinearLayout
                android:id="@+id/cardGoalDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_goal_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvIconDaily"
                    android:layout_width="@dimen/goal_letter_circle_size"
                    android:layout_height="@dimen/goal_letter_circle_size"
                    android:background="@drawable/bg_auth_logo_white"
                    android:backgroundTint="@color/goal_option_blue"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitleDaily"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="@string/goal_option_daily"
                        android:textColor="@color/goal_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:text="@string/goal_option_daily_desc"
                        android:textColor="@color/goal_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivCheckDaily"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/goal_icon_description"
                    android:src="@drawable/ic_goal_check_blue"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option 2: Work / TOEIC -->
            <LinearLayout
                android:id="@+id/cardGoalToeic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_goal_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvIconToeic"
                    android:layout_width="@dimen/goal_letter_circle_size"
                    android:layout_height="@dimen/goal_letter_circle_size"
                    android:background="@drawable/bg_auth_logo_white"
                    android:backgroundTint="@color/goal_option_orange"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="W"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitleToeic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="@string/goal_option_toeic"
                        android:textColor="@color/goal_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:text="@string/goal_option_toeic_desc"
                        android:textColor="@color/goal_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivCheckToeic"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/goal_icon_description"
                    android:src="@drawable/ic_goal_check_blue"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option 3: Study / IELTS -->
            <LinearLayout
                android:id="@+id/cardGoalIelts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_goal_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvIconIelts"
                    android:layout_width="@dimen/goal_letter_circle_size"
                    android:layout_height="@dimen/goal_letter_circle_size"
                    android:background="@drawable/bg_auth_logo_white"
                    android:backgroundTint="#8B5CF6"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitleIelts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="@string/goal_option_ielts"
                        android:textColor="@color/goal_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:text="@string/goal_option_ielts_desc"
                        android:textColor="@color/goal_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivCheckIelts"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/goal_icon_description"
                    android:src="@drawable/ic_goal_check_blue"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Option 4: School Exams -->
            <LinearLayout
                android:id="@+id/cardGoalSchool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_goal_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvIconSchool"
                    android:layout_width="@dimen/goal_letter_circle_size"
                    android:layout_height="@dimen/goal_letter_circle_size"
                    android:background="@drawable/bg_auth_logo_white"
                    android:backgroundTint="@color/goal_option_green"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitleSchool"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="@string/goal_option_school"
                        android:textColor="@color/goal_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:text="@string/goal_option_school_desc"
                        android:textColor="@color/goal_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivCheckSchool"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/goal_icon_description"
                    android:src="@drawable/ic_goal_check_blue"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoalContinue"
        style="@style/Widget.AuraEnglish.AuthPrimaryButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/goal_button_height"
        android:layout_marginHorizontal="@dimen/goal_screen_padding"
        android:layout_marginBottom="12dp"
        android:text="@string/goal_btn_continue"
        app:layout_constraintBottom_toTopOf="@id/tvGoalSkip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvGoalSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:padding="8dp"
        android:text="@string/goal_btn_skip"
        android:textColor="@color/goal_text_secondary"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
