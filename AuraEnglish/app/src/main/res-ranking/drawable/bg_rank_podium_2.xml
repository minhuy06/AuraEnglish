<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#333B82F6" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF2563EB"
                android:startColor="@color/rank_podium_2"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
