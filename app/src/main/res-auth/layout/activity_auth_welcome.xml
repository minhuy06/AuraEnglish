<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAuthWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/welcomeHero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_auth_header"
        android:paddingHorizontal="@dimen/auth_screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.58"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:background="@drawable/bg_auth_circle"
            android:translationX="38dp"
            android:translationY="-36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="90dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_auth_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvWelcomeLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_auth_logo_white"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:gravity="center"
            android:text="@string/auth_logo_letter"
            android:textColor="@color/auth_primary"
            android:textSize="28sp"
            app:layout_constraintBottom_toTopOf="@id/tvWelcomeTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/auth_welcome_title"
            android:textColor="@color/white"
            android:textSize="25sp"
            app:layout_constraintBottom_toTopOf="@id/tvWelcomeSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:gravity="center"
            android:text="@string/auth_welcome_subtitle"
            android:textColor="@color/auth_text_on_primary_muted"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/welcomeSkills"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/welcomeSkills"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWelcomeSubtitle"
            app:layout_constraintVertical_bias="0.35">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_auth_pill"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:gravity="center"
                android:paddingHorizontal="13dp"
                android:text="@string/auth_skill_vocab"
                android:textColor="@color/auth_primary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_auth_pill"
                android:backgroundTint="@color/auth_yellow"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:paddingHorizontal="13dp"
                android:text="@string/auth_skill_grammar"
                android:textColor="@color/auth_primary_dark"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_auth_pill"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:gravity="center"
                android:paddingHorizontal="13dp"
                android:text="@string/auth_skill_listening"
                android:textColor="@color/auth_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvWelcomeTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:gravity="center"
        android:text="@string/auth_terms_note"
        android:textColor="@color/auth_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeHero" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWelcomeRegister"
        style="@style/Widget.AuraEnglish.AuthPrimaryButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginHorizontal="@dimen/auth_screen_padding"
        android:layout_marginBottom="12dp"
        android:text="@string/auth_action_register"
        app:layout_constraintBottom_toTopOf="@id/btnWelcomeLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWelcomeLogin"
        style="@style/Widget.AuraEnglish.AuthOutlinedButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginHorizontal="@dimen/auth_screen_padding"
        android:layout_marginBottom="22dp"
        android:text="@string/auth_action_have_account"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
