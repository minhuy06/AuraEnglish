<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_practice_screen"
    tools:context=".practice.ui.PracticeResultActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/practice_screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/practice_header_icon"
            android:layout_height="@dimen/practice_header_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_practice_close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/practice_result_title"
            android:textColor="@color/practice_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="@dimen/practice_header_icon"
            android:layout_height="@dimen/practice_header_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/practice_view_answers"
            android:src="@drawable/ic_practice_share" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/practice_screen_padding"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_practice_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_practice_index"
                    android:gravity="center"
                    android:textColor="@color/practice_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="685" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đề thi thử 01"
                        android:textColor="@color/practice_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/practice_result_good"
                        android:textColor="@color/practice_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCorrectTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/practice_text_secondary"
                        android:textSize="12sp"
                        tools:text="Đúng 148/200 câu" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/practice_text_secondary"
                        android:textSize="12sp"
                        tools:text="Thời gian: 108:32" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_practice_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/practice_listening"
                        android:textColor="@color/practice_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvListening"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/practice_listening"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="340 / 495" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_practice_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/practice_reading"
                        android:textColor="@color/practice_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvReading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/practice_reading"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="345 / 495" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStatCorrect"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_practice_card"
                    android:gravity="center"
                    android:textColor="@color/practice_correct"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Đúng\n148" />

                <TextView
                    android:id="@+id/tvStatWrong"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_practice_card"
                    android:gravity="center"
                    android:textColor="@color/practice_wrong"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Sai\n42" />

                <TextView
                    android:id="@+id/tvStatSkip"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_practice_card"
                    android:gravity="center"
                    android:textColor="@color/practice_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Bỏ qua\n10" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_practice_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/practice_result_by_part"
                    android:textColor="@color/practice_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/resultPart1"
                    layout="@layout/item_practice_part" />

                <include
                    android:id="@+id/resultPart2"
                    layout="@layout/item_practice_part" />

                <include
                    android:id="@+id/resultPart3"
                    layout="@layout/item_practice_part" />

                <include
                    android:id="@+id/resultPart4"
                    layout="@layout/item_practice_part" />

                <include
                    android:id="@+id/resultPart5"
                    layout="@layout/item_practice_part" />

                <include
                    android:id="@+id/resultPart6"
                    layout="@layout/item_practice_part" />

                <include
                    android:id="@+id/resultPart7"
                    layout="@layout/item_practice_part" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/practice_surface"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.9"
            android:background="@drawable/bg_practice_soft_btn"
            android:gravity="center"
            android:text="@string/practice_retry"
            android:textColor="@color/practice_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnViewAnswers"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_practice_primary_btn"
            android:gravity="center"
            android:text="@string/practice_view_answers"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
