<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/practice_card_gap"
    android:background="@drawable/bg_practice_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="@dimen/practice_index_size"
        android:layout_height="@dimen/practice_index_size"
        android:background="@drawable/bg_practice_index"
        android:gravity="center"
        android:textColor="@color/practice_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="04" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/practice_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="ĐỀ THI THỬ 04" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/practice_exam_meta"
            android:textColor="@color/practice_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_practice_status_todo"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/practice_text_secondary"
            android:textSize="11sp"
            tools:text="Chưa làm" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_practice_chevron" />
</LinearLayout>
