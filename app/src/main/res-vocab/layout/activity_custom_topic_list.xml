<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCustomTopicList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vocab_bg">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTopicsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/vocab_custom_topics_title"
        android:textColor="@color/vocab_text_primary"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTopicsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:text="@string/vocab_custom_topics_subtitle"
        android:textColor="@color/vocab_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTopicsTitle" />

    <!-- Thanh tìm kiếm chủ đề -->
    <LinearLayout
        android:id="@+id/searchTopicContainer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="@dimen/vocab_screen_padding"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_vocab_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTopicsSubtitle">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/vocab_search_topic_hint"
            android:src="@drawable/ic_practice_search"
            app:tint="@color/vocab_text_muted" />

        <EditText
            android:id="@+id/edtSearchTopic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:hint="@string/vocab_search_topic_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/vocab_text_primary"
            android:textColorHint="@color/vocab_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Danh sách chủ đề (RecyclerView chuẩn Chương 6) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomTopics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/vocab_screen_padding"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchTopicContainer" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyTopics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:text="@string/vocab_empty_topics"
        android:textColor="@color/vocab_text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchTopicContainer" />

    <!-- Nút nổi Tạo chủ đề mới + -->
    <TextView
        android:id="@+id/btnCreateNewTopic"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_vocab_btn_primary"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="22dp"
        android:text="@string/vocab_btn_create_topic"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/includeBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Navigation -->
    <include
        android:id="@+id/includeBottomNav"
        layout="@layout/include_practice_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
