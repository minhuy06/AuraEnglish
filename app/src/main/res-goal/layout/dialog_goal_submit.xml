<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_goal_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Close button -->
    <ImageView
        android:id="@+id/btnDialogSubmitClose"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/goal_icon_description"
        android:padding="4dp"
        android:src="@drawable/ic_goal_close" />

    <!-- Checkmark Icon in Circle -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/goal_icon_description"
        android:src="@drawable/ic_goal_confirm_check" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:text="@string/goal_submit_title"
        android:textColor="@color/goal_text_primary"
        android:textSize="18sp" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/goal_submit_message"
        android:textColor="@color/goal_text_secondary"
        android:textSize="13sp" />

    <!-- Stats Box (Đã trả lời, Bỏ qua) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_goal_reading_box"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDialogAnsweredCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="Đã trả lời: 18/20"
            android:textColor="@color/goal_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDialogSkippedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:text="Bỏ qua: 2 câu"
            android:textColor="@color/goal_error_red"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Horizontal Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSubmitContinue"
            style="@style/Widget.AuraEnglish.AuthOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/goal_button_height"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/goal_submit_continue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSubmitConfirm"
            style="@style/Widget.AuraEnglish.AuthPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/goal_button_height"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/goal_submit_confirm" />
    </LinearLayout>

    <!-- Footnote -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:gravity="center"
        android:text="@string/goal_submit_note"
        android:textColor="@color/goal_text_secondary"
        android:textSize="11sp" />

</LinearLayout>
