<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAdminCourseItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_admin_card"
    android:padding="14dp">

    <!-- Tag danh mục • CEFR -->
    <TextView
        android:id="@+id/tvCourseSkillTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_course_tag"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="@color/admin_primary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Badge trạng thái: Đang hiển thị / Bản nháp -->
    <TextView
        android:id="@+id/tvCourseStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_free_badge"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="@color/admin_success"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@id/tvCourseSkillTag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvCourseSkillTag" />

    <!-- Tên khóa học -->
    <TextView
        android:id="@+id/tvCourseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:textColor="@color/admin_text_primary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCourseSkillTag" />

    <!-- Thống kê chủ đề • bài học • học viên -->
    <TextView
        android:id="@+id/tvCourseStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:textColor="@color/admin_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCourseName" />

    <!-- Hàng 3 nút hành động -->
    <LinearLayout
        android:id="@+id/layoutCourseActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCourseStats">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCoursePrimaryAction"
            style="@style/Widget.AuraEnglish.AdminSoftButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.4"
            android:paddingHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCourseEdit"
            style="@style/Widget.AuraEnglish.AdminNeutralButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="0.9"
            android:paddingHorizontal="6dp"
            android:text="@string/admin_action_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCourseDangerAction"
            style="@style/Widget.AuraEnglish.AdminDangerButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="0.7"
            android:paddingHorizontal="6dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
