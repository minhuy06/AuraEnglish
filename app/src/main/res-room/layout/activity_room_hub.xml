<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRoomHub"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/room_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp">

        <!-- Hero Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroRoomHub"
            android:layout_width="0dp"
            android:layout_height="176dp"
            android:background="@drawable/bg_room_hero"
            android:padding="@dimen/room_screen_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackRoomHub"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/room_back_desc"
                android:src="@drawable/ic_practice_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvHubHeroTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/room_feature_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBackRoomHub" />

            <TextView
                android:id="@+id/tvHubHeroSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/room_feature_subtitle"
                android:textColor="@color/room_primary_soft"
                android:textSize="12.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHubHeroTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card Tạo phòng thi mới -->
        <LinearLayout
            android:id="@+id/cardCreateRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/room_screen_padding"
            android:layout_marginTop="-28dp"
            android:background="@drawable/bg_room_card"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroRoomHub">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/room_hub_create_section"
                android:textColor="@color/room_primary_royal"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/room_hub_name_label"
                android:textColor="@color/room_text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtRoomName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_room_chip_inactive"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:hint="@string/room_hub_name_hint"
                android:inputType="textCapSentences"
                android:paddingHorizontal="12dp"
                android:text="@string/room_hub_name_default"
                android:textColor="@color/room_text_primary"
                android:textColorHint="@color/room_text_muted"
                android:textSize="13.5sp" />

            <!-- Chọn chủ đề: TOEIC / Ngữ pháp -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/room_hub_topic_label"
                android:textColor="@color/room_text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipTopicToeic"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_room_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="@string/room_topic_toeic"
                    android:textColor="@color/white"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/chipTopicGrammar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_room_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:gravity="center"
                    android:text="@string/room_topic_grammar"
                    android:textColor="@color/room_text_secondary"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Chọn số câu hỏi & thời gian -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:text="@string/room_hub_config_label"
                android:textColor="@color/room_text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipConfigQuick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_room_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="@string/room_hub_config_quick"
                    android:textColor="@color/white"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipConfigStandard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_room_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:gravity="center"
                    android:text="@string/room_hub_config_standard"
                    android:textColor="@color/room_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCreateRoom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/room_btn_height"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_room_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/room_hub_btn_create"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Card Tham gia bằng mã phòng -->
        <LinearLayout
            android:id="@+id/cardJoinRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/room_screen_padding"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_room_card"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCreateRoom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/room_hub_join_section"
                android:textColor="@color/room_text_secondary"
                android:textSize="11.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtJoinRoomCode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_room_chip_inactive"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:hint="@string/room_hub_code_hint"
                    android:inputType="textCapCharacters"
                    android:maxLength="6"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/room_text_primary"
                    android:textColorHint="@color/room_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_room_btn_outlined"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="@string/room_hub_btn_join"
                    android:textColor="@color/room_primary_royal"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvJoinCodeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:textColor="@color/room_danger_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
