<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dash_card_soft"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/accent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dash_skill_vocab">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_dash_vocab" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dash_body"
                android:textColor="@color/dash_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Tiếng anh công sở" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/dash_body"
                android:textColor="@color/dash_text_muted"
                android:textSize="13sp"
                tools:text="6 chủ đề • 24 bài học" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dash_progress_track">

        <View
            android:id="@+id/progressFill"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_dash_progress_fill" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/dash_body"
        android:textColor="@color/dash_text_muted"
        android:textSize="13sp"
        tools:text="Đang học 12/24 bài" />
</LinearLayout>
