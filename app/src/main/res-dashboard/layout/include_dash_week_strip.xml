<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dash_display"
        android:text="@string/dash_week_title"
        android:textColor="@color/dash_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dayMon"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dash_week_done"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/dash_week_mon"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dayTue"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dash_week_done"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/dash_week_tue"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dayWed"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dash_week_done"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/dash_week_wed"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dayThu"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dash_week_today"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/dash_week_thu"
            android:textColor="@color/dash_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dayFri"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dash_week_idle"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/dash_week_fri"
            android:textColor="@color/dash_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/daySat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dash_week_idle"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/dash_week_sat"
            android:textColor="@color/dash_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/daySun"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dash_week_idle"
            android:fontFamily="@font/dash_body"
            android:gravity="center"
            android:text="@string/dash_week_sun"
            android:textColor="@color/dash_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
