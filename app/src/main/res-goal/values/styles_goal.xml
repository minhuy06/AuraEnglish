<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AuraEnglish.GoalPrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/goal_accent_yellow</item>
        <item name="android:textColor">@color/goal_primary_dark</item>
        <item name="cornerRadius">@dimen/goal_button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
    </style>

    <style name="Widget.AuraEnglish.GoalOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/goal_text_white_muted</item>
        <item name="android:textColor">@color/goal_text_white</item>
        <item name="cornerRadius">@dimen/goal_button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
    </style>

    <style name="Widget.AuraEnglish.GoalDarkPrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/goal_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/goal_button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
    </style>
</resources>
