<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChangePassword"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp">

        <!-- Hero Header xanh đậm -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroChangePassword"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:background="@drawable/bg_profile_hero_header"
            android:padding="@dimen/profile_screen_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBackChangePassword"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_btn_back"
                android:src="@drawable/ic_practice_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/badgeHeroKey"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_profile_badge_yellow"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:text="K"
                android:textColor="@color/profile_badge_yellow_text"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBackChangePassword" />

            <TextView
                android:id="@+id/tvHeroPwdTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="@string/profile_pwd_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/badgeHeroKey"
                app:layout_constraintTop_toTopOf="@id/badgeHeroKey" />

            <TextView
                android:id="@+id/tvHeroPwdSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:text="@string/profile_pwd_subtitle"
                android:textColor="@color/profile_primary_soft"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/badgeHeroKey"
                app:layout_constraintTop_toBottomOf="@id/tvHeroPwdTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Card Form 3 ô mật khẩu -->
        <LinearLayout
            android:id="@+id/cardPasswordForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/profile_screen_padding"
            android:layout_marginTop="-32dp"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/heroChangePassword">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCurrentPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_label_current_pwd"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCurrentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:inputType="textPassword"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNewPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_label_new_pwd"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:inputType="textPassword"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/profile_label_confirm_pwd"
                app:endIconMode="password_toggle"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:inputType="textPassword"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvForgotCurrentPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:paddingVertical="4dp"
                android:text="@string/profile_forgot_pwd"
                android:textColor="@color/profile_primary_royal"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Hộp Mẹo bảo mật -->
        <TextView
            android:id="@+id/tvSecurityTipBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/profile_screen_padding"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_profile_btn_outlined"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:padding="14dp"
            android:text="@string/profile_security_tip"
            android:textColor="@color/profile_primary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPasswordForm" />

        <!-- Nút Cập nhật mật khẩu & Hủy -->
        <TextView
            android:id="@+id/btnUpdatePassword"
            android:layout_width="0dp"
            android:layout_height="@dimen/profile_btn_height"
            android:layout_marginHorizontal="@dimen/profile_screen_padding"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_profile_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/profile_btn_update_pwd"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSecurityTipBox" />

        <TextView
            android:id="@+id/tvCancelChangePassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/profile_btn_cancel"
            android:textColor="@color/profile_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnUpdatePassword" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
