<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <!-- Trạng thái 1: Đã có thành viên -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardMemberFilled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_room_card"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvMemberAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_room_avatar_circle"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:textColor="@color/room_text_primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/btnKickMember"
            app:layout_constraintStart_toEndOf="@id/tvMemberAvatar"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvMemberRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_room_badge_ready"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/room_success_text"
            android:textSize="10.5sp"
            app:layout_constraintStart_toEndOf="@id/tvMemberAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvMemberName" />

        <ImageButton
            android:id="@+id/btnKickMember"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/room_lobby_kick_desc"
            android:src="@drawable/ic_practice_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/room_danger_text" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Trạng thái 2: Slot còn trống -->
    <TextView
        android:id="@+id/tvEmptyMemberSlot"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_room_slot_empty"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:gravity="center"
        android:text="@string/room_lobby_empty_slot"
        android:textColor="@color/room_text_muted"
        android:textSize="12.5sp"
        android:visibility="gone" />

</FrameLayout>
