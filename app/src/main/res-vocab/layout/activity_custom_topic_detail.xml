<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCustomTopicDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vocab_bg">

    <!-- Header -->
    <ImageButton
        android:id="@+id/btnBackTopicDetail"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/vocab_screen_padding"
        android:layout_marginTop="14dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/vocab_back_desc"
        android:src="@drawable/ic_practice_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/vocab_text_primary" />

    <TextView
        android:id="@+id/tvDetailTopicName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:ellipsize="end"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/vocab_text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBackTopicDetail" />

    <TextView
        android:id="@+id/tvDetailTopicSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:textColor="@color/vocab_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDetailTopicName" />

    <!-- Thanh tìm kiếm từ vựng -->
    <LinearLayout
        android:id="@+id/searchWordContainer"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="@dimen/vocab_screen_padding"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_vocab_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDetailTopicSubtitle">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/vocab_search_word_hint"
            android:src="@drawable/ic_practice_search"
            app:tint="@color/vocab_text_muted" />

        <EditText
            android:id="@+id/edtSearchWord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:hint="@string/vocab_search_word_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/vocab_text_primary"
            android:textColorHint="@color/vocab_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Banner Tổng quan & Nút Học ngay ▶ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardSummaryBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vocab_screen_padding"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_vocab_summary_banner"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchWordContainer">

        <TextView
            android:id="@+id/tvSummaryTotalWords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:textColor="@color/vocab_text_primary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSummaryLearnedWords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:textColor="@color/vocab_primary_royal"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSummaryTotalWords" />

        <ProgressBar
            android:id="@+id/pbDetailTopicProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:max="100"
            android:progress="62"
            android:progressDrawable="@drawable/progress_vocab_horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnStudyNow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSummaryLearnedWords" />

        <TextView
            android:id="@+id/btnStudyNow"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_vocab_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/vocab_btn_study_now"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3 Tab lọc: Tất cả / Chưa thuộc / Đã thuộc (Chuẩn LinearLayout weight + width 0dp Chương 3) -->
    <LinearLayout
        android:id="@+id/layoutFilterTabs"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginHorizontal="@dimen/vocab_screen_padding"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardSummaryBanner">

        <TextView
            android:id="@+id/tabFilterAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_vocab_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabFilterUnlearned"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vocab_tab_inactive"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:gravity="center"
            android:textColor="@color/vocab_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tabFilterLearned"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_vocab_tab_inactive"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:gravity="center"
            android:textColor="@color/vocab_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Danh sách từ vựng -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTopicWords"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/vocab_screen_padding"
        android:paddingBottom="84dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFilterTabs" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyWords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:text="@string/vocab_empty_words"
        android:textColor="@color/vocab_text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFilterTabs" />

    <!-- Nút nổi Thêm từ mới + -->
    <TextView
        android:id="@+id/btnAddNewWord"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_vocab_btn_primary"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="@string/vocab_btn_add_word"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
