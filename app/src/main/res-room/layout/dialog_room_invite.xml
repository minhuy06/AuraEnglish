<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_room_card"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/room_invite_title"
            android:textColor="@color/room_text_primary"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/btnCloseInviteDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/room_invite_btn_cancel"
            android:src="@drawable/ic_practice_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvInviteSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:textColor="@color/room_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/room_invite_label"
        android:textColor="@color/room_text_primary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edtInviteUsername"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_room_chip_inactive"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:hint="@string/room_invite_hint"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="@color/room_text_primary"
        android:textColorHint="@color/room_text_muted"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvInviteError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:textColor="@color/room_danger_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnConfirmInvite"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_room_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/room_invite_btn_confirm"
        android:textColor="@color/white"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/tvCancelInvite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/be_vietnam_pro_semibold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="@string/room_invite_btn_cancel"
        android:textColor="@color/room_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
