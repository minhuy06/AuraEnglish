<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAdminCourseManage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerAdminCourse"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_header"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAdminCourseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/admin_course_manage_title"
            android:textColor="@color/admin_text_primary"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/btnAddNewCourse"
            app:layout_constraintEnd_toStartOf="@id/btnAddNewCourse"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnAddNewCourse" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddNewCourse"
            style="@style/Widget.AuraEnglish.AdminPrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="14dp"
            android:text="@string/admin_course_btn_add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Thanh tìm kiếm -->
        <LinearLayout
            android:id="@+id/searchCourseContainer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_admin_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnAddNewCourse">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/admin_course_search_hint"
                android:src="@drawable/ic_admin_search" />

            <EditText
                android:id="@+id/edtSearchCourse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:hint="@string/admin_course_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/admin_text_primary"
                android:textColorHint="@color/admin_text_placeholder"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 4 Chip lọc danh mục -->
        <HorizontalScrollView
            android:id="@+id/scrollCourseChips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchCourseContainer">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCourseAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_admin_chip_active"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipCourseVocab"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_admin_chip_inactive"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipCourseGrammar"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_admin_chip_inactive"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipCourseListen"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_admin_chip_inactive"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Danh sách khóa học (RecyclerView + ListAdapter chuẩn Chương 6) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminCourses"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@id/includeAdminBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerAdminCourse" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyAdminCourses"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_medium"
        android:text="@string/admin_course_empty"
        android:textColor="@color/admin_text_placeholder"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/includeAdminBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerAdminCourse" />

    <!-- Admin Bottom Nav dùng chung -->
    <include
        android:id="@+id/includeAdminBottomNav"
        layout="@layout/include_admin_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="@dimen/admin_bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
