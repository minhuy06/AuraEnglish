<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_dash_card_soft"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvIndex"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/dash_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="01" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dash_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Bộ đề Toeic - Nâng cao" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/dash_text_secondary"
            android:textSize="10sp"
            tools:text="60 đề - Listening + Reading" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_owned_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/dash_owned_text"
            android:textSize="11sp"
            tools:text="Đã mua" />

        <TextView
            android:id="@+id/btnAction"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dash_buy_btn"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Mua" />
    </LinearLayout>
</LinearLayout>
