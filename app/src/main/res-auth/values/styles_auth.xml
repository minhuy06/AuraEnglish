<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.AuraEnglish.AuthInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/auth_surface</item>
        <item name="boxCornerRadiusTopStart">@dimen/auth_input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/auth_input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/auth_input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/auth_input_radius</item>
        <item name="boxStrokeColor">@color/auth_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/auth_text_secondary</item>
        <item name="startIconTint">@color/auth_primary</item>
        <item name="endIconTint">@color/auth_text_secondary</item>
        <item name="errorTextColor">@color/auth_error</item>
        <item name="android:textColorHint">@color/auth_text_hint</item>
    </style>

    <style name="Widget.AuraEnglish.AuthPrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/auth_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/auth_button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
    </style>

    <style name="Widget.AuraEnglish.AuthOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/auth_surface</item>
        <item name="strokeColor">@color/auth_primary</item>
        <item name="android:textColor">@color/auth_primary</item>
        <item name="cornerRadius">@dimen/auth_button_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/be_vietnam_pro_bold</item>
    </style>
</resources>
