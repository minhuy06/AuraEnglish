<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="@dimen/admin_bottom_nav_height"
    android:background="@drawable/bg_admin_bottom_nav"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/navStats"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavStats"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/admin_nav_stats"
            android:src="@drawable/ic_admin_stats" />

        <TextView
            android:id="@+id/tvNavStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/admin_nav_stats"
            android:textColor="@color/admin_nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navCourses"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavCourses"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/admin_nav_courses"
            android:src="@drawable/ic_admin_course" />

        <TextView
            android:id="@+id/tvNavCourses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/admin_nav_courses"
            android:textColor="@color/admin_nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navExams"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavExams"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/admin_nav_exams"
            android:src="@drawable/ic_admin_exam" />

        <TextView
            android:id="@+id/tvNavExams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/admin_nav_exams"
            android:textColor="@color/admin_nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navStudents"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavStudents"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/admin_nav_students"
            android:src="@drawable/ic_admin_students" />

        <TextView
            android:id="@+id/tvNavStudents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/admin_nav_students"
            android:textColor="@color/admin_nav_inactive"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
