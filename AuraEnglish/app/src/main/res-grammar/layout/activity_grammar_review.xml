<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGrammarReview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grammar_bg"
    android:padding="@dimen/grammar_screen_padding">

    <!-- Header -->
    <ImageButton
        android:id="@+id/btnBackGrammarReview"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/grammar_back_desc"
        android:src="@drawable/ic_practice_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/grammar_text_primary" />

    <TextView
        android:id="@+id/tvReviewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:text="@string/grammar_title"
        android:textColor="@color/grammar_text_primary"
        android:textSize="17sp"
        app:layout_constraintEnd_toStartOf="@id/tvReviewTimer"
        app:layout_constraintStart_toEndOf="@id/btnBackGrammarReview"
        app:layout_constraintTop_toTopOf="@id/btnBackGrammarReview" />

    <TextView
        android:id="@+id/tvReviewSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/be_vietnam_pro_regular"
        android:textColor="@color/grammar_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/tvReviewTimer"
        app:layout_constraintStart_toEndOf="@id/btnBackGrammarReview"
        app:layout_constraintTop_toBottomOf="@id/tvReviewTitle" />

    <TextView
        android:id="@+id/tvReviewTimer"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:background="@drawable/bg_grammar_timer_pill"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="@string/grammar_timer_default"
        android:textColor="@color/grammar_primary_royal"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/tvReviewSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvReviewTitle" />

    <!-- Progress Bar + Counter -->
    <ProgressBar
        android:id="@+id/pbReviewProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="7dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/progress_vocab_horizontal"
        app:layout_constraintEnd_toStartOf="@id/tvReviewCounter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvReviewSubtitle" />

    <TextView
        android:id="@+id/tvReviewCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:textColor="@color/grammar_primary_royal"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/pbReviewProgress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/pbReviewProgress" />

    <!-- Thanh cuộn ngang chọn câu hỏi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuestionNav"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pbReviewProgress" />

    <!-- Card chi tiết câu hỏi & Giải thích -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReviewBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnNextReviewQuestion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvQuestionNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_grammar_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvReviewQuestionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:textColor="@color/grammar_primary_royal"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReviewQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/grammar_text_primary"
                android:textSize="15sp" />

            <!-- 4 Đáp án kết quả A-D -->
            <LinearLayout
                android:id="@+id/reviewOptionA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_grammar_option_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvRevALetter"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_grammar_circle_default"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRevAText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRevAMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewOptionB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_grammar_option_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvRevBLetter"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_grammar_circle_default"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRevBText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRevBMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewOptionC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_grammar_option_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvRevCLetter"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_grammar_circle_default"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRevCText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRevCMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewOptionD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_grammar_option_default"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvRevDLetter"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_grammar_circle_default"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRevDText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRevDMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Hộp Giải thích chi tiết màu vàng kem -->
            <LinearLayout
                android:id="@+id/boxExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_grammar_explanation_box"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:text="@string/grammar_explain_title"
                    android:textColor="@color/grammar_explain_title"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvExplanationRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/grammar_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvExplanationExample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:textColor="@color/grammar_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút Câu tiếp theo → -->
    <TextView
        android:id="@+id/btnNextReviewQuestion"
        android:layout_width="0dp"
        android:layout_height="@dimen/grammar_btn_height"
        android:background="@drawable/bg_grammar_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/grammar_btn_next_review"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
