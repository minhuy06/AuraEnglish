<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAuthOtp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_background">

    <include
        android:id="@+id/authHeader"
        layout="@layout/include_auth_header"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_header_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/otpCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/auth_screen_padding"
        android:layout_marginTop="180dp"
        android:background="@drawable/bg_auth_card"
        android:elevation="7dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/auth_code_label"
            android:textColor="@color/auth_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOtpSentTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:textColor="@color/auth_text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            tools:ignore="LabelFor">

            <EditText
                android:id="@+id/edtOtp1"
                style="@style/Widget.AppCompat.EditText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_otp_box"
                android:contentDescription="@string/auth_otp_digit_description"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/auth_primary"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtOtp2"
                style="@style/Widget.AppCompat.EditText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_otp_box"
                android:contentDescription="@string/auth_otp_digit_description"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/auth_primary"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtOtp3"
                style="@style/Widget.AppCompat.EditText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_otp_box"
                android:contentDescription="@string/auth_otp_digit_description"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/auth_primary"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtOtp4"
                style="@style/Widget.AppCompat.EditText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_otp_box"
                android:contentDescription="@string/auth_otp_digit_description"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/auth_primary"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtOtp5"
                style="@style/Widget.AppCompat.EditText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_otp_box"
                android:contentDescription="@string/auth_otp_digit_description"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/auth_primary"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtOtp6"
                style="@style/Widget.AppCompat.EditText"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_auth_otp_box"
                android:contentDescription="@string/auth_otp_digit_description"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="1"
                android:selectAllOnFocus="true"
                android:textColor="@color/auth_primary"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOtpError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:gravity="center"
            android:text="@string/auth_error_code_incomplete"
            android:textColor="@color/auth_error"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvOtpCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:gravity="center"
            android:textColor="@color/auth_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOtpPrimary"
        style="@style/Widget.AuraEnglish.AuthPrimaryButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginHorizontal="@dimen/auth_screen_padding"
        android:layout_marginBottom="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvOtpSecondary"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:fontFamily="@font/be_vietnam_pro_bold"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:textColor="@color/auth_primary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOtpPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>
