<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAssessmentResult"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/goal_bg_light">

    <!-- Top Hero Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerResultHero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_goal_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/bg_auth_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="@string/goal_result_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvResultLevelPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_goal_pill"
            android:backgroundTint="#33FFFFFF"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Trung cấp"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvResultTitle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/goal_screen_padding"
        app:layout_constraintBottom_toTopOf="@id/btnResultDetail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerResultHero">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Skills Breakdown Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/goal_card_radius"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Vocab -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro_medium"
                            android:text="Từ vựng"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvVocabScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="75%"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbVocab"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="75"
                        android:progressDrawable="@drawable/progress_skill_horizontal" />

                    <!-- Grammar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro_medium"
                            android:text="Ngữ pháp"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvGrammarScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="60%"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbGrammar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="60"
                        android:progressDrawable="@drawable/progress_skill_horizontal" />

                    <!-- Listening -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro_medium"
                            android:text="Nghe"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvListeningScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="55%"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbListening"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="55"
                        android:progressDrawable="@drawable/progress_skill_horizontal" />

                    <!-- Reading -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro_medium"
                            android:text="Đọc hiểu"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvReadingScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="68%"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbReading"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="68"
                        android:progressDrawable="@drawable/progress_skill_horizontal" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recommendation Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="@dimen/goal_card_radius"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_auth_logo_white"
                        android:backgroundTint="@color/goal_accent_yellow"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:gravity="center"
                        android:text="→"
                        android:textColor="@color/goal_primary_dark"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="Lộ trình đề xuất: Tiếng Anh công sở"
                            android:textColor="@color/goal_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:text="Bắt đầu từ B1 · 8 tuần"
                            android:textColor="@color/goal_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResultDetail"
        style="@style/Widget.AuraEnglish.AuthOutlinedButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/goal_button_height"
        android:layout_marginHorizontal="@dimen/goal_screen_padding"
        android:layout_marginBottom="12dp"
        android:text="@string/goal_btn_view_detail"
        app:layout_constraintBottom_toTopOf="@id/btnResultStartLearning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResultStartLearning"
        style="@style/Widget.AuraEnglish.AuthPrimaryButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/goal_button_height"
        android:layout_marginHorizontal="@dimen/goal_screen_padding"
        android:layout_marginBottom="24dp"
        android:text="@string/goal_btn_start_learning"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
