<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dash_hero"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dash_display"
        android:text="@string/dash_hero_title"
        android:textColor="@color/dash_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeroSuggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/dash_body"
        android:lineSpacingMultiplier="1.35"
        android:text="@string/dash_hero_suggest"
        android:textColor="@color/dash_text_muted"
        android:textSize="15sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/btnHeroCta"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_dash_cta"
        android:fontFamily="@font/dash_body"
        android:gravity="center"
        android:minWidth="148dp"
        android:paddingHorizontal="20dp"
        android:text="@string/dash_hero_cta"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
