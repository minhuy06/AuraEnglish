<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_admin_popup"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/popup_edit_exam_title"
        android:textColor="@color/admin_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_exam_name"
        android:textColor="@color/admin_text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etExamName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_admin_input"
        android:hint="@string/hint_exam_name"
        android:inputType="textCapSentences"
        android:paddingHorizontal="12dp"
        android:textColor="@color/admin_text_primary"
        android:textColorHint="@color/admin_text_placeholder"
        android:textSize="13sp"
        tools:text="Đề thi thử TOEIC 01" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_exam_count"
        android:textColor="@color/admin_text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etExamCount"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_admin_input"
        android:hint="@string/hint_exam_count"
        android:inputType="number"
        android:paddingHorizontal="12dp"
        android:textColor="@color/admin_text_primary"
        android:textColorHint="@color/admin_text_placeholder"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_exam_desc"
        android:textColor="@color/admin_text_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_admin_input"
        android:gravity="top|start"
        android:hint="@string/hint_exam_desc"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/admin_text_primary"
        android:textColorHint="@color/admin_text_placeholder"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.AuraEnglish.AdminNeutralButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/action_cancel"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.AuraEnglish.AdminPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/action_save"
            android:textSize="13sp"
            app:cornerRadius="@dimen/admin_btn_radius" />
    </LinearLayout>
</LinearLayout>
